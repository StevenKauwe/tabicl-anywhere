# Third-party reference source, Python environments and downloaded checkpoints: never commit.
/ref/
# Generated test data (over 1 GB; tools/dump_*.py regenerate it).
/fixtures/
# Weight files and fitted bundles anywhere (the deployable half-size parts in docs/weights are .bin, not .tirs).
*.tirs
*.ckpt
*.sealed

# Build output.
/target/
/target-web/
/pkg/
# Generated by tools/build-site.sh inside site/; the deployable copy is committed in docs/ (tools/deploy-docs.sh).
/site/pkg/
/site/index.html
/site/.nojekyll
/site/weights/*-half.*

# Python, editor and OS junk.
__pycache__/
*.pyc
.venv/
node_modules/
*.tmp
*.swp
*~
.#*
.idea/
.vscode/
.DS_Store
Thumbs.db
